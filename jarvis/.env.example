# Anthropic API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model to use for the chat loop. Check console.anthropic.com/docs for the
# current model list before running — this default may age out.
JARVIS_MODEL=claude-sonnet-4-5

# Path to the SQLite database file (created automatically on first run).
JARVIS_DB_PATH=./data/jarvis.db

# Your name, used to personalize the system prompt.
JARVIS_USER_NAME=
